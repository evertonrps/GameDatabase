<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1"/>
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1"/>
        <PackageReference Include="HotChocolate.AspNetCore" Version="15.1.13"/>
        <PackageReference Include="HotChocolate.Data.EntityFramework" Version="15.1.13"/>
        <PackageReference Include="HotChocolate.PersistedQueries.FileSystem" Version="13.9.15"/>
        <PackageReference Include="HotChocolate.Types.Analyzers" Version="15.1.13">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="HotChocolate.Types.Json" Version="15.1.13"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameDatabase.Domain\GameDatabase.Domain.csproj"/>
        <ProjectReference Include="..\GameDatabase.IoC\GameDatabase.IoC.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Controllers\v2"/>
        <Folder Include="Schema\Filters"/>
        <Folder Include="Schema\Sorters"/>
        <Folder Include="Schema\Subscriptions"/>
    </ItemGroup>

</Project>
